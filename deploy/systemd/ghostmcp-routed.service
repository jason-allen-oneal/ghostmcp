[Unit]
Description=GhostMCP Server (Tor-routed external tools)
After=network-online.target tor@default.service
Wants=network-online.target
Requires=tor@default.service

[Service]
Type=simple
User=ghostmcp
Group=ghostmcp
WorkingDirectory=/opt/ghostmcp
EnvironmentFile=/etc/ghostmcp/ghostmcp.env
Environment=GHOSTMCP_PROXY_MODE=tor
Environment=GHOSTMCP_REQUIRE_ROUTED_EXECUTION=true
Environment=GHOSTMCP_CREDENTIAL_STORE=/var/lib/ghostmcp/credentials.bin
Environment=GHOSTMCP_DB_PATH=/var/lib/ghostmcp/ghostmcp.db
Environment=GHOSTMCP_AUDIT_SINK_PATH=/var/log/ghostmcp/audit.jsonl
ExecStart=/opt/ghostmcp/.venv/bin/ghostmcp
Restart=on-failure
RestartSec=3
StateDirectory=ghostmcp
LogsDirectory=ghostmcp
RuntimeDirectory=ghostmcp
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
NoExecPaths=/tmp /var/lib/ghostmcp /var/log/ghostmcp
ReadWritePaths=/var/lib/ghostmcp /var/log/ghostmcp

[Install]
WantedBy=multi-user.target
